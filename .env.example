# Данные твоего зарегистрированного приложения hh (https://dev.hh.ru/admin)
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Либо готовый токен напрямую (тогда CLIENT_ID/SECRET не нужны)
# HH_ACCESS_TOKEN=

# Необязательно: свой User-Agent (hh просит идентифицировать приложение)
# HH_USER_AGENT=hh-vacancies-analyzer/1.0 (your-email@example.com)

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=            # от @BotFather (или положи в token.txt рядом со скриптом)
# Доступ выдаётся инвайт-кодами (/invite у админа), список пользователей — в таблице users.
# TELEGRAM_ALLOWED_CHATS=123,456   # только сидинг: эти chat_id заводятся в users при старте
# TELEGRAM_ADMIN_CHATS=123          # /invite, /users, /ban, /stats, /collect, /dict и алерты

# --- LLM-анализ ---
# Приоритет провайдеров: сначала прямой Gemini API, затем OpenRouter, затем базовый режим.
GEMINI_API_KEY=               # ключ Google Gemini (прямой API, высший приоритет)
# модели Gemini по приоритету (через запятую): при ошибке (503 и т.п.) берётся следующая
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GEMINI_FORCE_IPV4=1          # если IPv6 VPS отвергается Gemini по геолокации
OPENROUTER_API_KEY=           # ключ OpenRouter (sk-or-...); резерв, если Gemini не сработал
# модели по приоритету (через запятую): при ошибке берётся следующая, дефолт — список ниже
# OPENROUTER_MODELS=openai/gpt-oss-120b:free,nvidia/nemotron-3-nano-30b-a3b:free,cohere/north-mini-code:free
# LLM_MODE=auto                # auto (LLM с откатом) | llm (только LLM) | basic (без LLM)
# LLM_BATCH_SIZE=50            # вакансий в одном батче LLM (упирается в LLM_MAX_TOKENS, не в контекст)
# LLM_MAX_DESC=1500            # обрезка описания на вакансию, символов
# LLM_MAX_TOKENS=32000         # лимит ВЫВОДА модели; мал -> обрезает JSON на больших батчах (Gemini flash: до ~64K)
# LLM_DUMP=0                   # писать сырой результат первой фазы LLM в JSONL (1 — включить)
# LLM_DUMP_DIR=llm_dumps       # каталог для этих дампов

# --- параметры анализа (есть дефолты, можно не задавать) ---
# COLLECT_HOURS=6              # интервал фонового сбора
# DEFAULT_QUERY_TEXT=python    # отслеживаемый запрос (для трендов)
# DEFAULT_AREA=113             # регион: 113=Россия, 1=Москва, 2=СПб
# ANALYZE_TOP_N=200            # сколько свежих вакансий обогащать деталями за сбор
# ONDEMAND_TOP_N=100           # то же для разового кастомного запроса
# CUSTOM_FRESH_HOURS=6         # сколько часов снимок кастомного запроса свежий (тогда /top читает из базы без LLM)
# DETAIL_THROTTLE=0.2          # пауза между запросами деталей, сек
# TREND_PERIOD_DAYS=30         # окно тренда по умолчанию
# TOP_N_DEFAULT=15             # размер топа по умолчанию
# RETENTION_RAW_DAYS=90        # сколько дней хранить сырьё отслеживаемых запросов
# RETENTION_ADHOC_DAYS=7       # то же для разовых запросов (они и раздувают базу)
# DB_PATH=hh_stats.db          # файл SQLite

# --- многопользовательский режим ---
# WORKERS=2                    # сколько задач очереди выполняется одновременно
# HH_CONCURRENCY=1             # параллельных обращений к hh (общий токен и IP — не поднимать)
# LLM_CONCURRENCY=2            # параллельных анализов через LLM
# LLM_DAILY_QUOTA_USER=5       # LLM-сборов в сутки на пользователя
# LLM_DAILY_QUOTA_GLOBAL=100   # общий суточный потолок; сверх него — откат на словарь
# TRACK_LIMIT_USER=2           # сколько запросов пользователь может отслеживать
# TRACKED_MAX_TOTAL=40         # предел уникальных отслеживаемых пар (нагрузка фона)
# TRACK_COLLECT_HOURS=24       # как часто собираются пользовательские подписки
